    <mxCell id="s2_adduser" value="addUser()&#xa;• Auto-increment ID&#xa;• strncpy username&#xa;• xorTransform(password)&#xa;• Set role + linkedDoctorId&#xa;• Append to list tail&#xa;• saveUsers()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
