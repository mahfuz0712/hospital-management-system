    <mxCell id="s3_add" value="addAppointment()&#xa;• Auto-increment ID&#xa;• Set patientId, doctorId&#xa;• strncpy date, time&#xa;• status = APPT_SCHEDULED&#xa;• Append to list&#xa;• saveAppointments()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="285" y="1606" width="180" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s3_success" value="Success: Appointment booked" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="295" y="1734" width="160" height="40" as="geometry"/>
    </mxCell>

    <!-- arrows section 3 -->
