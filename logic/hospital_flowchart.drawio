      <mxGeometry x="640" y="440" width="170" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="s2_deluser" value="deleteUser()&#xa;• Walk list with prev ptr&#xa;• Unlink node&#xa;• free(node)&#xa;• Return new head&#xa;• saveUsers()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
