                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="s5_link" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;linkedDoctorId check&lt;br&gt;findDoctorById(linkedDoctorId)&lt;br&gt;&lt;br&gt;&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="130" y="900" width="220" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="s5_menu" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;DOCTOR MENU — Dr. [name]&lt;br&gt;1. View My Appointments&lt;br&gt;   displayAppointmentsByDoctorId()&lt;br&gt;   [filtered by own doctorId]&lt;br&gt;2. View a Specific Patient&lt;br&gt;   Auth check: patient must have&lt;br&gt;   appointment WITH this doctor&lt;br&gt;0. Logout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="95" y="1242.5" width="255" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="s5_auth" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Patient Authorization:&lt;br&gt;Loop appointments:&lt;br&gt;  a.patientId == input AND&lt;br&gt;  a.doctorId == myId?&lt;br&gt;YES → displayPatient()&lt;br&gt;NO  → &#39;Not assigned to you&#39;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="90" y="1460" width="250" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s6_label" value="6. DATA LAYER — KEY ALGORITHMS SUMMARY" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="930" y="2620" width="440" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="s6_xor" value="PASSWORD SECURITY: XOR Cipher&#xa;────────────────────────────&#xa;xorTransform(input, output):&#xa;  key = &#39;NUB_CSE_SD1&#39;&#xa;  for i in 0..len(input):&#xa;    output[i] = input[i] XOR key[i % keyLen]&#xa;  output[len] = &#39;\0&#39;&#xa;&#xa;• XOR is symmetric: apply twice = original&#xa;• Same fn used for scramble AND verify&#xa;• NOT cryptographic — demonstrates principle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;arcSize=0;" parent="1" vertex="1">
                    <mxGeometry x="935" y="2670" width="270" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="s6_linear" value="LINEAR SEARCH (used everywhere on linked list)&#xa;────────────────────────────────────────────&#xa;findById, findByUsername, findByName,&#xa;findAvailableDoctorBySpecialization,&#xa;isDoctorAvailableAt, displayByPatientId,&#xa;displayByDoctorId&#xa;&#xa;Complexity: O(n)&#xa;Why: Linked list has no random access.&#xa;Each node must be visited in order." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;arcSize=0;" parent="1" vertex="1">
                    <mxGeometry x="1235" y="2670" width="333" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="s6_binary" value="BINARY SEARCH (Patient by ID, Appointment by Date)&#xa;──────────────────────────────────────────────────&#xa;Cannot binary-search a linked list directly.&#xa;Solution:&#xa;  1. Count nodes → n&#xa;  2. malloc array of n pointers&#xa;  3. Copy node ptrs into array&#xa;  4. qsort(array) by key field&#xa;  5. Binary search on sorted array:&#xa;     low=0, high=n-1&#xa;     mid = low + (high-low)/2&#xa;     compare arr[mid] with target&#xa;  6. free(array), return result&#xa;&#xa;Date comparison: DD-MM-YYYY → YYYYMMDD int&#xa;Complexity: O(n log n) sort + O(log n) search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;arcSize=0;" parent="1" vertex="1">
                    <mxGeometry x="1600" y="2670" width="373" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="s6_fileio" value="BINARY FILE I/O (all 5 modules same pattern)&#xa;────────────────────────────────────────────&#xa;SAVE: fopen(file, &#39;wb&#39;)&#xa;  for each node: fwrite(&amp;node, sizeof, 1, fp)&#xa;  fclose()&#xa;&#xa;LOAD: fopen(file, &#39;rb&#39;)&#xa;  while fread(&amp;temp, sizeof, 1, fp) == 1:&#xa;    malloc new node&#xa;    *node = temp (copy struct)&#xa;    node→next = NULL&#xa;    append to tail&#xa;  fclose()&#xa;&#xa;Why binary not text/CSV?&#xa;• Struct has fixed-size arrays + enum&#xa;• No delimiter/parsing issues&#xa;• One fwrite per record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;arcSize=0;" parent="1" vertex="1">
                    <mxGeometry x="2000" y="2670" width="340" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="s6_autoid" value="AUTO-INCREMENT ID (all modules)&#xa;────────────────────────────────&#xa;maxId = 0&#xa;for each node in list:&#xa;  if node→id &gt; maxId: maxId = node→id&#xa;newNode→id = maxId + 1&#xa;&#xa;Why: No database sequence available.&#xa;Guarantees unique, ascending IDs&#xa;even after deletions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;arcSize=0;" parent="1" vertex="1">
                    <mxGeometry x="2380" y="2670" width="250" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="s7_label" value="7. VALIDATION LAYER" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="930" y="2980" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="s7_date" value="isValidDate(date)&#xa;• strlen == 10&#xa;• date[2] == &#39;-&#39;, date[5] == &#39;-&#39;&#xa;• All other chars isdigit()&#xa;• day: 01-31, month: 01-12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="930" y="3027.5" width="180" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="s7_time" value="isValidTime(time)&#xa;• strlen == 5&#xa;• time[2] == &#39;:&#39;&#xa;• Other chars isdigit()&#xa;• hour: 00-23, min: 00-59" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1162" y="3030" width="175" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="s7_phone" value="isValidPhone(phone)&#xa;• strlen 7-15&#xa;• All chars isdigit()&#xa;• (unsigned char) cast safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1377" y="3030" width="170" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="s7_readint" value="readInt(prompt)&#xa;• printf prompt&#xa;• readLine → temp[32]&#xa;• strtol(temp, &amp;endPtr, 10)&#xa;• valid if: temp[0]≠&#39;\0&#39;&#xa;  AND *endPtr==&#39;\0&#39;&#xa;• Loop until valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1607" y="3027.5" width="170" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="s7_readline" value="readLine(buffer, size)&#xa;• fgets(buffer, size, stdin)&#xa;• Strip trailing &#39;\n&#39;&#xa;• trimString():&#xa;  - shift leading spaces left&#xa;  - null-terminate trailing spaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
                    <mxGeometry x="1830" y="3027.5" width="185" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="s8_label" value="8. FEATURE STATUS" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="2750" width="200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="s8_done" value="&amp;nbsp;IMPLEMENTED&lt;br&gt;─────────────────────────&lt;br&gt;• Role-based auth (Admin/Employee/Doctor)&lt;br&gt;• XOR password obfuscation&lt;br&gt;• First-run default admin seeding&lt;br&gt;• User: Add, View, Update, Delete&lt;br&gt;• Patient: Add, View, Update, Delete&lt;br&gt;• Patient: Linear search by name&lt;br&gt;• Patient: Binary search by ID&lt;br&gt;• Doctor: Add, View, Update, Delete&lt;br&gt;• Doctor: Linear search by name&lt;br&gt;• Doctor: Toggle availability&lt;br&gt;• Doctor: findAvailableBySpecialization&lt;br&gt;• Appointment: Book by specialization&lt;br&gt;• Appointment: Double-booking guard&lt;br&gt;  (isDoctorAvailableAt — Cancelled frees slot)&lt;br&gt;• Appointment: View all / by Patient / by Doctor&lt;br&gt;• Appointment: Update status (Sched/Comp/Cancel)&lt;br&gt;• Appointment: Delete&lt;br&gt;• Appointment: Binary search by date&lt;br&gt;• Billing: Create, View, Delete&lt;br&gt;• Billing: Auto-compute totalAmount&lt;br&gt;• Billing: View by Patient ID&lt;br&gt;• Billing: Receipt display&lt;br&gt;• Reports: Patient/Doctor/Appt/Revenue summary&lt;br&gt;• Doctor menu: restricted to own patients only&lt;br&gt;• Binary file I/O for all 5 data stores&lt;br&gt;• Input validation: date, time, phone, int, float" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=center;arcSize=0;" parent="1" vertex="1">
                    <mxGeometry x="2400" y="110" width="370" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="e_role_emp" value="EMPLOYEE" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s1_role" target="s4_menu" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_role_doc" value="DOCTOR" style="edgeStyle=orthogonalEdgeStyle;" parent="1" source="s1_role" target="s5_link" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
