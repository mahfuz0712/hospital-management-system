                <mxCell id="s4_menu" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;EMPLOYEE MENU&lt;br&gt;1. Add Patient&lt;br&gt;2. View All Patients&lt;br&gt;3. Search Patient by Name&lt;br&gt;4. Book Appointment [same double-booking guard]&lt;br&gt;5. View All Appointments&lt;br&gt;6. Create Bill&lt;br&gt;7. View Receipt by Bill ID&lt;br&gt;0. Logout&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="460" y="1170" width="300" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="s4_note" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;NOTE: Employee has NO access to:&lt;br&gt;• Manage Users&lt;br&gt;• Manage Doctors&lt;br&gt;• Reports&lt;br&gt;• Update/Delete Appointments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" parent="1" vertex="1">
                    <mxGeometry x="455" y="1467.5" width="310" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="s5_label" value="5. DOCTOR MENU (Read-Only, Self-Restricted)" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="107.5" y="725.5" width="320" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="16" style="edgeStyle=none;html=1;" parent="1" source="s5_link" target="15" edge="1">
