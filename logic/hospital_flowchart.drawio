    <!-- ========================================================
         SECTION 4: EMPLOYEE MENU
    ======================================================== -->
    <mxCell id="s4_label" value="4. EMPLOYEE MENU" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="800" y="800" width="220" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="s4_menu" value="EMPLOYEE MENU&#xa;1. Add Patient&#xa;2. View All Patients&#xa;3. Search Patient by Name&#xa;4. Book Appointment [same double-booking guard]&#xa;5. View All Appointments&#xa;6. Create Bill&#xa;7. View Receipt by Bill ID&#xa;0. Logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="800" y="848" width="230" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="s4_note" value="NOTE: Employee has NO access to:&#xa;• Manage Users&#xa;• Manage Doctors&#xa;• Reports&#xa;• Update/Delete Appointments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="800" y="1005" width="200" height="80" as="geometry"/>
    </mxCell>

    <!-- ========================================================
         SECTION 5: DOCTOR MENU
    ======================================================== -->
    <mxCell id="s5_label" value="5. DOCTOR MENU (Read-Only, Self-Restricted)" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="1060" y="800" width="320" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="s5_link" value="linkedDoctorId check&#xa;findDoctorById(linkedDoctorId)&#xa;NULL? → error, return" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
      <mxGeometry x="1090" y="850" width="170" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="s5_menu" value="DOCTOR MENU — Dr. [name]&#xa;1. View My Appointments&#xa;   displayAppointmentsByDoctorId()&#xa;   [filtered by own doctorId]&#xa;2. View a Specific Patient&#xa;   Auth check: patient must have&#xa;   appointment WITH this doctor&#xa;0. Logout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="1080" y="940" width="215" height="130" as="geometry"/>
    </mxCell>
    <mxCell id="s5_auth" value="Patient Authorization:&#xa;Loop appointments:&#xa;  a.patientId == input AND&#xa;  a.doctorId == myId?&#xa;YES → displayPatient()&#xa;NO  → 'Not assigned to you'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="1080" y="1088" width="210" height="100" as="geometry"/>
    </mxCell>

    <!-- ========================================================
         SECTION 6: DATA LAYER ALGORITHMS SUMMARY
    ======================================================== -->
    <mxCell id="s6_label" value="6. DATA LAYER — KEY ALGORITHMS SUMMARY" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="1800" width="440" height="30" as="geometry"/>
    </mxCell>

    <mxCell id="s6_xor" value="PASSWORD SECURITY: XOR Cipher&#xa;────────────────────────────&#xa;xorTransform(input, output):&#xa;  key = 'NUB_CSE_SD1'&#xa;  for i in 0..len(input):&#xa;    output[i] = input[i] XOR key[i % keyLen]&#xa;  output[len] = '\0'&#xa;&#xa;• XOR is symmetric: apply twice = original&#xa;• Same fn used for scramble AND verify&#xa;• NOT cryptographic — demonstrates principle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="200" y="1848" width="270" height="160" as="geometry"/>
    </mxCell>

    <mxCell id="s6_linear" value="LINEAR SEARCH (used everywhere on linked list)&#xa;────────────────────────────────────────────&#xa;findById, findByUsername, findByName,&#xa;findAvailableDoctorBySpecialization,&#xa;isDoctorAvailableAt, displayByPatientId,&#xa;displayByDoctorId&#xa;&#xa;Complexity: O(n)&#xa;Why: Linked list has no random access.&#xa;Each node must be visited in order." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="490" y="1848" width="290" height="160" as="geometry"/>
    </mxCell>

    <mxCell id="s6_binary" value="BINARY SEARCH (Patient by ID, Appointment by Date)&#xa;──────────────────────────────────────────────────&#xa;Cannot binary-search a linked list directly.&#xa;Solution:&#xa;  1. Count nodes → n&#xa;  2. malloc array of n pointers&#xa;  3. Copy node ptrs into array&#xa;  4. qsort(array) by key field&#xa;  5. Binary search on sorted array:&#xa;     low=0, high=n-1&#xa;     mid = low + (high-low)/2&#xa;     compare arr[mid] with target&#xa;  6. free(array), return result&#xa;&#xa;Date comparison: DD-MM-YYYY → YYYYMMDD int&#xa;Complexity: O(n log n) sort + O(log n) search" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="800" y="1848" width="310" height="220" as="geometry"/>
    </mxCell>

    <mxCell id="s6_fileio" value="BINARY FILE I/O (all 5 modules same pattern)&#xa;────────────────────────────────────────────&#xa;SAVE: fopen(file, 'wb')&#xa;  for each node: fwrite(&amp;node, sizeof, 1, fp)&#xa;  fclose()&#xa;&#xa;LOAD: fopen(file, 'rb')&#xa;  while fread(&amp;temp, sizeof, 1, fp) == 1:&#xa;    malloc new node&#xa;    *node = temp (copy struct)&#xa;    node→next = NULL&#xa;    append to tail&#xa;  fclose()&#xa;&#xa;Why binary not text/CSV?&#xa;• Struct has fixed-size arrays + enum&#xa;• No delimiter/parsing issues&#xa;• One fwrite per record" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="1130" y="1848" width="290" height="230" as="geometry"/>
    </mxCell>

    <mxCell id="s6_autoid" value="AUTO-INCREMENT ID (all modules)&#xa;────────────────────────────────&#xa;maxId = 0&#xa;for each node in list:&#xa;  if node→id &gt; maxId: maxId = node→id&#xa;newNode→id = maxId + 1&#xa;&#xa;Why: No database sequence available.&#xa;Guarantees unique, ascending IDs&#xa;even after deletions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="1440" y="1848" width="250" height="170" as="geometry"/>
    </mxCell>

    <!-- ========================================================
         SECTION 7: VALIDATION LAYER
    ======================================================== -->
    <mxCell id="s7_label" value="7. VALIDATION LAYER" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="2040" width="200" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="s7_date" value="isValidDate(date)&#xa;• strlen == 10&#xa;• date[2] == '-', date[5] == '-'&#xa;• All other chars isdigit()&#xa;• day: 01-31, month: 01-12" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="200" y="2088" width="180" height="95" as="geometry"/>
    </mxCell>
    <mxCell id="s7_time" value="isValidTime(time)&#xa;• strlen == 5&#xa;• time[2] == ':'&#xa;• Other chars isdigit()&#xa;• hour: 00-23, min: 00-59" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="395" y="2088" width="175" height="95" as="geometry"/>
    </mxCell>
    <mxCell id="s7_phone" value="isValidPhone(phone)&#xa;• strlen 7-15&#xa;• All chars isdigit()&#xa;• (unsigned char) cast safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="585" y="2088" width="170" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="s7_readint" value="readInt(prompt)&#xa;• printf prompt&#xa;• readLine → temp[32]&#xa;• strtol(temp, &amp;endPtr, 10)&#xa;• valid if: temp[0]≠'\0'&#xa;  AND *endPtr=='\0'&#xa;• Loop until valid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="770" y="2088" width="170" height="110" as="geometry"/>
    </mxCell>
    <mxCell id="s7_readline" value="readLine(buffer, size)&#xa;• fgets(buffer, size, stdin)&#xa;• Strip trailing '\n'&#xa;• trimString():&#xa;  - shift leading spaces left&#xa;  - null-terminate trailing spaces" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="955" y="2088" width="185" height="100" as="geometry"/>
    </mxCell>

    <!-- ========================================================
         SECTION 8: IMPLEMENTED vs NOT IMPLEMENTED
    ======================================================== -->
    <mxCell id="s8_label" value="8. FEATURE STATUS" style="text;html=1;strokeColor=#001f60;fillColor=#dae8fc;align=center;fontStyle=1;fontSize=12;rounded=1;" vertex="1" parent="1">
      <mxGeometry x="200" y="2220" width="200" height="30" as="geometry"/>
    </mxCell>
    <mxCell id="s8_done" value="✅ IMPLEMENTED&#xa;─────────────────────────&#xa;• Role-based auth (Admin/Employee/Doctor)&#xa;• XOR password obfuscation&#xa;• First-run default admin seeding&#xa;• User: Add, View, Update, Delete&#xa;• Patient: Add, View, Update, Delete&#xa;• Patient: Linear search by name&#xa;• Patient: Binary search by ID&#xa;• Doctor: Add, View, Update, Delete&#xa;• Doctor: Linear search by name&#xa;• Doctor: Toggle availability&#xa;• Doctor: findAvailableBySpecialization&#xa;• Appointment: Book by specialization&#xa;• Appointment: Double-booking guard&#xa;  (isDoctorAvailableAt — Cancelled frees slot)&#xa;• Appointment: View all / by Patient / by Doctor&#xa;• Appointment: Update status (Sched/Comp/Cancel)&#xa;• Appointment: Delete&#xa;• Appointment: Binary search by date&#xa;• Billing: Create, View, Delete&#xa;• Billing: Auto-compute totalAmount&#xa;• Billing: View by Patient ID&#xa;• Billing: Receipt display&#xa;• Reports: Patient/Doctor/Appt/Revenue summary&#xa;• Doctor menu: restricted to own patients only&#xa;• Binary file I/O for all 5 data stores&#xa;• Input validation: date, time, phone, int, float" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="200" y="2268" width="330" height="380" as="geometry"/>
    </mxCell>
    <mxCell id="s8_todo" value="⬜ NOT YET IMPLEMENTED (future scope)&#xa;─────────────────────────────────────&#xa;• Real password hashing (SHA-256 + salt)&#xa;• Days-per-month calendar validation&#xa;  (e.g. 31-02-2026 currently passes)&#xa;• Search users by username/role&#xa;• Update Appointment (date/time/doctor change)&#xa;• Update Bill amounts after creation&#xa;• Appointment reminder / upcoming view&#xa;• Multi-result name search&#xa;  (current returns only first match)&#xa;• Pagination for large lists&#xa;• Inno Setup .exe packaging&#xa;• Doctor: view own profile/details&#xa;• Employee: update patient records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" vertex="1" parent="1">
      <mxGeometry x="550" y="2268" width="310" height="290" as="geometry"/>
    </mxCell>

    <!-- role arrows to menus -->
    <mxCell id="e_role_emp" value="EMPLOYEE" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1_role" target="s4_menu" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_role_doc" value="DOCTOR" style="edgeStyle=orthogonalEdgeStyle;" edge="1" source="s1_role" target="s5_link" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>
    <mxCell id="e_appts_booking" value="Book&#xa;detail" style="edgeStyle=orthogonalEdgeStyle;dashed=1;" edge="1" source="s2_appts" target="s3_start" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell>

